#!/usr/bin/env python3
"""Hide the Omarchy menu entries a standard (non-sudo) user cannot use.

Every menu entry whose action ends up calling sudo, pkexec or run0 only
produces an error or a prompt for the admin password, so it is hidden through
the user's menu extension file. The list is derived from the installed Omarchy
scripts on every run, so it follows Omarchy updates; that is why this runs at
each login.

Usage: omarchy-standard-menu [--list] [--output FILE]
  --list         print the entries that would be hidden and change nothing
  --output FILE  write somewhere else than the user's menu extension file

The whole file is owned by this script: entries added by hand are kept in a
.bak copy once and then replaced.
"""

import collections
import json
import os
import re
import shutil
import sys

OMARCHY_PATH = os.environ.get("OMARCHY_PATH", "/usr/share/omarchy")
BIN = os.path.join(OMARCHY_PATH, "bin")
STOCK_MENU = os.path.join(OMARCHY_PATH, "default/omarchy/omarchy-menu.jsonc")
USER_MENU = os.path.expanduser("~/.config/omarchy/extensions/omarchy-menu.jsonc")
MARKER = "// Generated by omarchy-standard-menu"

# Privileged helpers a standard user is allowed to run anyway, because
# add-standard-user.sh installs a sudoers rule for them.
ALLOWED = {"omarchy-theme-set-browser-policy"}

# Menu ids to keep visible even though the scan flags them (false positives).
KEEP = set()

COMMAND = re.compile(r"omarchy-[a-z0-9][a-z0-9-]*")
# The AUR helpers call sudo themselves, so they count as well.
ESCALATION = re.compile(r"(?<![\w-])(sudo|pkexec|run0|yay|paru)(?![\w-])")


def code_of(path):
    try:
        with open(path, errors="replace") as file:
            lines = file.read().split("\n")
    except OSError:
        return ""
    return "\n".join(line for line in lines if not line.lstrip().startswith("#"))


def build_graph():
    names = set(os.listdir(BIN))
    escalates, calls = {}, {}
    for name in names:
        code = code_of(os.path.join(BIN, name))
        escalates[name] = name not in ALLOWED and bool(ESCALATION.search(code))
        calls[name] = {c for c in COMMAND.findall(code) if c in names} - {name}
    return names, escalates, calls


def privileged_commands(start, escalates, calls):
    seen, queue, found = set(), collections.deque(start), []
    while queue:
        name = queue.popleft()
        if name in seen:
            continue
        seen.add(name)
        if escalates.get(name):
            found.append(name)
        queue.extend(calls.get(name, ()))
    return sorted(found)


def read_jsonc(path):
    # Same stripping the menu itself does: whole-line comments, trailing commas.
    with open(path) as file:
        raw = file.read()
    raw = re.sub(r"^\s*//[^\n]*(\n|$)", "", raw, flags=re.M)
    raw = re.sub(r",(\s*[}\]])", r"\1", raw)
    return json.loads(raw)


def hidden_entries():
    names, escalates, calls = build_graph()
    hidden = {}
    for menu_id, entry in read_jsonc(STOCK_MENU).items():
        if menu_id in KEEP or not isinstance(entry, dict):
            continue
        action = entry.get("action", "")
        start = {c for c in COMMAND.findall(action) if c in names}
        reasons = privileged_commands(start, escalates, calls)
        if reasons or ESCALATION.search(action):
            hidden[menu_id] = (entry, reasons)
    return hidden


def render(hidden):
    lines = [
        "{",
        "  " + MARKER + " -- do not edit, rewritten at every login.",
        "  // Hides the menu entries that need root, which this user does not have.",
        "  // An override replaces the whole entry, so each one is repeated in full.",
    ]
    for menu_id, (entry, _) in hidden.items():
        entry = dict(entry, when="false")
        lines.append(
            "  %s: %s,"
            % (
                json.dumps(menu_id, ensure_ascii=False),
                json.dumps(entry, ensure_ascii=False, separators=(",", ":")),
            )
        )
    lines.append("}")
    return "\n".join(lines) + "\n"


def main(argv):
    output = USER_MENU
    list_only = False
    while argv:
        arg = argv.pop(0)
        if arg == "--list":
            list_only = True
        elif arg == "--output" and argv:
            output = argv.pop(0)
        else:
            sys.stderr.write(__doc__)
            return 1

    hidden = hidden_entries()
    if list_only:
        for menu_id, (_, reasons) in hidden.items():
            print("%s\t%s" % (menu_id, " ".join(reasons)))
        return 0

    content = render(hidden)
    try:
        with open(output) as file:
            current = file.read()
    except OSError:
        current = None
    if current == content:
        return 0

    os.makedirs(os.path.dirname(output), exist_ok=True)
    if current is not None and MARKER not in current and not os.path.exists(output + ".bak"):
        shutil.copy2(output, output + ".bak")
    temporary = output + ".tmp"
    with open(temporary, "w") as file:
        file.write(content)
    os.replace(temporary, output)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
